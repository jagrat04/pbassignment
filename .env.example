# Copy to .env for local runs. docker-compose.yml reads this file automatically.
# Every variable the stack reads is listed here, including the ones with
# working defaults, so nothing is discovered by grepping the source.

# --- database ---------------------------------------------------------------
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo
POSTGRES_DB=peblo
# Host port only. The API always reaches the database at db:5432 inside the
# compose network. 5433 by default because a developer machine very often
# already has Postgres on 5432, and on Windows both will happily bind it --
# connections then land on whichever answers first, which is a horrible hour
# to spend. Change it if you like; nothing inside the stack depends on it.
POSTGRES_PORT=5433
# Read by the API when you run it outside docker (tests, a local uvicorn).
# Use 127.0.0.1, not localhost: localhost may resolve to ::1 and reach a
# different Postgres than the one compose published.
DATABASE_URL=postgresql+psycopg://peblo:peblo@127.0.0.1:5433/peblo

# --- auth -------------------------------------------------------------------
# Signs the CMS session tokens. Anyone holding this can mint an admin token,
# so in production it comes from the secret store, never from a file.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- storage ----------------------------------------------------------------
# local | r2
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
# How the browser reaches locally stored images. In production this is the R2
# public bucket URL or the CDN in front of it.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# Only read when STORAGE_BACKEND=r2.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=peblo-tv
R2_PUBLIC_BASE_URL=https://cdn.mypeblo.com

# --- content rules ----------------------------------------------------------
REFERENCE_PATH=/seed/reference.json
SEED_PATH=/seed/seed_shows.json
SEED_ASSETS_DIR=/seed/assets
SEED_ON_START=true

# --- catalogue --------------------------------------------------------------
CATALOG_KEY=catalog/catalog.json
CATALOG_VERSIONS_PREFIX=catalog/versions

# --- web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Baked into both React bundles at build time (Vite inlines VITE_* at build).
VITE_API_BASE_URL=http://localhost:8000
